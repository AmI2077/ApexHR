<?xml version="1.0" encoding="utf-8"?><!--
   Правила резервного копирования и переноса данных для Android 12+ (API 31+).
   См. https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Токены сессии не копируем в облако. -->
        <exclude domain="file" path="datastore/TokenDataStore.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- И не переносим на новое устройство. -->
        <exclude domain="file" path="datastore/TokenDataStore.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
