<?xml version="1.0" encoding="utf-8"?><!--
   Правила автобэкапа для Android 11 и ниже (API < 31).
   См. https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Зашифрованные токены сессии. Ключ шифрования лежит в AndroidKeyStore
         и в бэкап не попадает, поэтому восстановленные токены всё равно
         нельзя расшифровать. Кроме того, токены не должны покидать устройство. -->
    <exclude domain="file" path="datastore/TokenDataStore.preferences_pb" />
</full-backup-content>
